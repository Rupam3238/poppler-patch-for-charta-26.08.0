# target to generate assembly for a file
splash/SplashXPathScanner.cc.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/poppler.dir/build.make CMakeFiles/poppler.dir/splash/SplashXPathScanner.cc.s
.PHONY : splash/SplashXPathScanner.cc.s

